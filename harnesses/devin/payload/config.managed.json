{
  "$schema-note": "install.py merges these keys into %APPDATA%/devin/config.json — never commit credentials.toml or org_id",
  "permissions": {
    "allow": [
      "Read(**)",
      "Write(**)",
      "Edit(**)",
      "Exec(**)"
    ],
    "deny": [
      "Read(**/.env*)",
      "Read(**/id_rsa*)",
      "Read(**/*.pem)",
      "Read(**/*.key)"
    ],
    "ask": [
      "Write(**/.env*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{PY}} \"{{DEVIN_HOME}}/hooks/pre_tool_guard.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
